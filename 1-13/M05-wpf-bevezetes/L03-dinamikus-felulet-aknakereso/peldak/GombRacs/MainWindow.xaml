<Window x:Class="GombRacs.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gombrács kódból" Height="560" Width="520" MinHeight="400" MinWidth="380"
        FontSize="15" WindowStartupLocation="CenterScreen">
    <DockPanel Margin="5">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <Label Content="Méret:"/>
            <ComboBox Name="MeretCombo" Width="70" Margin="5" SelectionChanged="MeretCombo_SelectionChanged"/>
            <Label Name="InfoLabel" Margin="10,0"/>
        </StackPanel>
        <!-- A rács üres: a gombokat a kód hozza létre -->
        <UniformGrid Name="Tabla" Margin="5"/>
    </DockPanel>
</Window>
