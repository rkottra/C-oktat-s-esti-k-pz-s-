<Window x:Class="KetLista.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Két lista" Height="480" Width="640" MinHeight="400" MinWidth="500"
        FontSize="16" WindowStartupLocation="CenterScreen">
    <Grid Margin="5">
        <!-- Bal lista | gombok | jobb lista -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Bal oldal -->
        <TextBox Grid.Row="0" Grid.Column="0" Name="BalTextBox" Margin="5"
                 TextChanged="BalTextBox_TextChanged"/>
        <ListBox Grid.Row="1" Grid.Column="0" Name="BalLista" Margin="5" Background="Beige"
                 SelectionChanged="Lista_SelectionChanged"/>
        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Name="BalHozzaadGomb" Content="Hozzáad" Margin="5" Padding="10,2" IsEnabled="False"
                    Click="BalHozzaadGomb_Click"/>
            <Button Name="BalTorolGomb" Content="Töröl" Margin="5" Padding="10,2" IsEnabled="False"
                    Click="BalTorolGomb_Click"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Mentés…" Margin="5" Padding="10,2" Click="MentesGomb_Click"/>
            <Button Content="Betöltés…" Margin="5" Padding="10,2" Click="BetoltesGomb_Click"/>
        </StackPanel>

        <!-- Középen az áthelyező gombok. A > jelet XAML-ben &gt;-ként kell írni -->
        <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
            <Button Name="JobbraGomb" Content="&gt;" Margin="5" IsEnabled="False" Click="JobbraGomb_Click"/>
            <Button Name="MindJobbraGomb" Content="&gt;&gt;" Margin="5" IsEnabled="False" Click="MindJobbraGomb_Click"/>
            <Button Name="BalraGomb" Content="&lt;" Margin="5" IsEnabled="False" Click="BalraGomb_Click"/>
            <Button Name="MindBalraGomb" Content="&lt;&lt;" Margin="5" IsEnabled="False" Click="MindBalraGomb_Click"/>
        </StackPanel>

        <!-- Jobb oldal -->
        <TextBox Grid.Row="0" Grid.Column="2" Name="JobbTextBox" Margin="5"
                 TextChanged="JobbTextBox_TextChanged"/>
        <ListBox Grid.Row="1" Grid.Column="2" Name="JobbLista" Margin="5" Background="Beige"
                 SelectionChanged="Lista_SelectionChanged"/>
        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Name="JobbHozzaadGomb" Content="Hozzáad" Margin="5" Padding="10,2" IsEnabled="False"
                    Click="JobbHozzaadGomb_Click"/>
            <Button Name="JobbTorolGomb" Content="Töröl" Margin="5" Padding="10,2" IsEnabled="False"
                    Click="JobbTorolGomb_Click"/>
        </StackPanel>
    </Grid>
</Window>
