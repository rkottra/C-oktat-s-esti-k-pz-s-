<Window x:Class="TanfolyamJelentkezes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tanfolyami jelentkezés" Height="470" Width="720" MinHeight="420" MinWidth="600"
        FontSize="15" WindowStartupLocation="CenterScreen">
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Bal oldal: űrlap egymás alatti elemekkel -->
        <StackPanel Grid.Column="0" Margin="5">
            <Label Content="Név:"/>
            <TextBox Name="NevTextBox" Margin="0,0,0,5"/>

            <Label Content="Tanfolyam:"/>
            <!-- ComboBox elemei XAML-ben megadva; SelectedIndex: az alapból kiválasztott elem -->
            <ComboBox Name="TanfolyamComboBox" SelectedIndex="0" Margin="0,0,0,5">
                <ComboBoxItem Content="C# programozás"/>
                <ComboBoxItem Content="Python alapok"/>
                <ComboBoxItem Content="Webfejlesztés"/>
                <ComboBoxItem Content="Adatbázis-kezelés"/>
            </ComboBox>

            <!-- Az egy panelben lévő RadioButtonok egy csoportot alkotnak: egyszerre egy választható -->
            <GroupBox Header="Napszak" Margin="0,5">
                <StackPanel Margin="5">
                    <RadioButton Name="DelelottRadio" Content="délelőtt"/>
                    <RadioButton Name="DelutanRadio" Content="délután"/>
                    <RadioButton Name="EsteRadio" Content="este" IsChecked="True"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Egyéb" Margin="0,5">
                <StackPanel Margin="5">
                    <CheckBox Name="TankonyvCheck" Content="tankönyvet kér"/>
                    <CheckBox Name="VizsgaCheck" Content="vizsgát is tesz"/>
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal">
                <Button Content="Jelentkezés" Margin="0,5,5,5" Padding="10,3" IsDefault="True"
                        Click="JelentkezesGomb_Click"/>
                <Button Name="TorlesGomb" Content="Törlés" Margin="5" Padding="10,3" IsEnabled="False"
                        Click="TorlesGomb_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Jobb oldal: lista és a kiválasztott elem részletei -->
        <DockPanel Grid.Column="1" Margin="5">
            <Label DockPanel.Dock="Top" Name="DarabLabel" Content="Jelentkezők: 0"/>
            <TextBlock DockPanel.Dock="Bottom" Name="ReszletekTextBlock" Margin="0,5"
                       Text="Válassz ki egy jelentkezőt!" TextWrapping="Wrap" MinHeight="60"
                       Background="Beige" Padding="5"/>
            <ListBox Name="JelentkezokLista" SelectionChanged="JelentkezokLista_SelectionChanged"/>
        </DockPanel>
    </Grid>
</Window>
