<Window x:Class="Teendolista.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teendőlista" Height="450" Width="560" MinHeight="300" MinWidth="460"
        FontSize="16" WindowStartupLocation="CenterScreen">
    <DockPanel Margin="5">
        <!-- Felül: beviteli sor -->
        <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Name="HozzaadGomb" Content="Hozzáad" Margin="5" Padding="10,2"
                    IsDefault="True" Click="HozzaadGomb_Click"/>
            <TextBox Name="TeendoTextBox" Margin="5" TextChanged="TeendoTextBox_TextChanged"/>
        </DockPanel>

        <!-- Alul: állapotsor és gombsor (a DockPanel a sorrendben előbb dokkoltat teszi kívülre) -->
        <Label DockPanel.Dock="Bottom" Name="AllapotLabel" Content="0 teendő"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
            <Button Name="KeszGomb" Content="Kész" Margin="5" Padding="10,2" Click="KeszGomb_Click"/>
            <Button Name="FelGomb" Content="Fel" Margin="5" Padding="10,2" Click="FelGomb_Click"/>
            <Button Name="LeGomb" Content="Le" Margin="5" Padding="10,2" Click="LeGomb_Click"/>
            <Button Name="TorolGomb" Content="Töröl" Margin="5" Padding="10,2" Click="TorolGomb_Click"/>
            <Button Name="MindTorlesGomb" Content="Mind törlése" Margin="5" Padding="10,2" Click="MindTorlesGomb_Click"/>
        </StackPanel>

        <!-- A maradék hely: a lista -->
        <ListBox Name="TeendoLista" Margin="5" SelectionChanged="TeendoLista_SelectionChanged"/>
    </DockPanel>
</Window>
