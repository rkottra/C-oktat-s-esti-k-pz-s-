<Window x:Class="NevsorKereses.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Névsor – keresés és szűrés" Height="500" Width="760" MinHeight="420" MinWidth="640"
        FontSize="15" WindowStartupLocation="CenterScreen">
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Bal oldal: szűrők. Az eseménykezelőket a konstruktor köti be (lásd a .cs fájlt). -->
        <StackPanel Grid.Column="0" Margin="5">
            <Label Content="Név (részlet):"/>
            <TextBox Name="NevTextBox" Margin="0,0,0,5"/>

            <Label Content="Osztály:"/>
            <ComboBox Name="OsztalyCombo" Margin="0,0,0,5"/>

            <CheckBox Name="JelesCheck" Content="csak jeles (4,5 felett)" Margin="0,5"/>

            <GroupBox Header="Rendezés" Margin="0,5">
                <StackPanel Margin="5">
                    <RadioButton Name="NevSzerintRadio" Content="név szerint" IsChecked="True"/>
                    <RadioButton Name="AtlagSzerintRadio" Content="átlag szerint (csökkenő)"/>
                </StackPanel>
            </GroupBox>

            <Button Content="Szűrők törlése" Margin="0,10" Padding="10,3" HorizontalAlignment="Left"
                    Click="TorlesGomb_Click"/>
        </StackPanel>

        <!-- Jobb oldal: találatok és részletek -->
        <DockPanel Grid.Column="1" Margin="5">
            <Label DockPanel.Dock="Top" Name="TalalatLabel"/>
            <Border DockPanel.Dock="Bottom" BorderBrush="Gray" BorderThickness="1" Margin="0,5,0,0"
                    Background="Beige" Padding="8">
                <TextBlock Name="ReszletekTextBlock" MinHeight="70" TextWrapping="Wrap"/>
            </Border>
            <ListBox Name="TalalatLista"/>
        </DockPanel>
    </Grid>
</Window>
