<Window x:Class="Szamlalo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Számláló" Height="220" Width="360" FontSize="18"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="5">
        <!-- Három egyforma oszlop és két egyforma sor -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.ColumnSpan="3" Name="ErtekLabel" Content="0"
               FontSize="40" FontWeight="Bold" Margin="5" Background="Beige"
               HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

        <Button Grid.Row="1" Grid.Column="0" Name="CsokkentGomb" Content="Csökkent" Margin="5"
                IsEnabled="False" Click="CsokkentGomb_Click"/>
        <Button Grid.Row="1" Grid.Column="1" Name="NullazGomb" Content="Nulláz" Margin="5"
                IsEnabled="False" Click="NullazGomb_Click"/>
        <Button Grid.Row="1" Grid.Column="2" Name="NovelGomb" Content="Növel" Margin="5"
                Click="NovelGomb_Click"/>
    </Grid>
</Window>
