<Window x:Class="StilusokEroforrasok.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stílusok és erőforrások" Height="520" Width="620" MinHeight="420" MinWidth="480"
        WindowStartupLocation="CenterScreen" Background="{StaticResource HatterSzin}">

    <Window.Resources>
        <!-- Ablakszintű erőforrások -->
        <Thickness x:Key="Hely">6</Thickness>
        <sys:Double x:Key="AlapMeret" xmlns:sys="clr-namespace:System;assembly=mscorlib">15</sys:Double>

        <!-- Implicit stílus (x:Key nélkül): az ablak MINDEN gombjára vonatkozik -->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="{StaticResource Hely}"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="FontSize" Value="{StaticResource AlapMeret}"/>
            <Setter Property="Background" Value="{StaticResource FoSzin}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <!-- Feltételes beállítás: csak amíg az egér a gomb fölött van -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="Gold"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Kulcsos stílus, amely az implicit gombstílust bővíti -->
        <Style x:Key="VeszelyesGomb" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource FigyelmeztetoSzin}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="Cim" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource FoSzin}"/>
            <Setter Property="Margin" Value="{StaticResource Hely}"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="FontSize" Value="{StaticResource AlapMeret}"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="10">
        <TextBlock Style="{StaticResource Cim}" Text="Stílusok és erőforrások"/>

        <!-- Mindegyik gomb ugyanúgy néz ki – a stílus miatt, nem egyenként beállítva -->
        <WrapPanel>
            <Button Content="Mentés"/>
            <Button Content="Megnyitás"/>
            <Button Content="Letiltott" IsEnabled="False"/>
            <Button Content="Törlés" Style="{StaticResource VeszelyesGomb}"/>
            <!-- A közvetlenül megadott érték felülírja a stílusét -->
            <Button Content="Egyedi" Background="SeaGreen"/>
        </WrapPanel>

        <Separator Margin="0,15"/>

        <!-- Adatkötés két vezérlő között: a csúszka értéke a minta betűmérete -->
        <TextBlock Style="{StaticResource Cim}" Text="Kötés két vezérlő között"/>
        <DockPanel Margin="{StaticResource Hely}">
            <Label DockPanel.Dock="Left" Content="Betűméret:"/>
            <Label DockPanel.Dock="Right" Width="90"
                   Content="{Binding ElementName=MeretSlider, Path=Value}" ContentStringFormat="{}{0:F0} pont"/>
            <Slider Name="MeretSlider" Minimum="10" Maximum="48" Value="20" VerticalAlignment="Center"
                    IsSnapToTickEnabled="True" TickFrequency="1"/>
        </DockPanel>
        <DockPanel Margin="{StaticResource Hely}">
            <Label DockPanel.Dock="Left" Content="Szöveg:"/>
            <TextBox Name="MintaTextBox" Text="Árvíztűrő tükörfúrógép" FontSize="{StaticResource AlapMeret}"/>
        </DockPanel>
        <Border BorderBrush="{StaticResource FoSzin}" BorderThickness="2" Margin="{StaticResource Hely}" Padding="10"
                Background="White">
            <!-- Két kötés: a szöveg a TextBox-ból, a méret a Slider-ből jön – egy sor C# nélkül -->
            <TextBlock Text="{Binding ElementName=MintaTextBox, Path=Text}"
                       FontSize="{Binding ElementName=MeretSlider, Path=Value}" TextWrapping="Wrap"/>
        </Border>
    </StackPanel>
</Window>
