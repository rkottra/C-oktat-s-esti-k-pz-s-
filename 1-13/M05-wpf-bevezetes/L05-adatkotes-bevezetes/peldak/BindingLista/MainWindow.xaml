<Window x:Class="BindingLista.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adatkötés – könyvlista" Height="480" Width="760" MinHeight="380" MinWidth="620"
        FontSize="15" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,3"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- Bal: a lista az ObservableCollection-höz kötve, DataTemplate-tel formázva -->
        <DockPanel Grid.Column="0" Margin="5">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                <Button Content="Új könyv" Click="UjGomb_Click"/>
                <Button Content="Törlés" Click="TorlesGomb_Click"/>
                <Label Content="{Binding Konyvek.Count}" ContentStringFormat="{}{0} könyv"/>
            </StackPanel>
            <ListBox Name="KonyvLista" ItemsSource="{Binding Konyvek}" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="4">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="kölcsönözve" Foreground="Firebrick"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <!-- DataTrigger: az adat értékétől függő megjelenés -->
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kolcsonozve}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel>
                                    <TextBlock Text="{Binding Cim}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Leiras}" Foreground="Gray" FontSize="13"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Jobb: részletek – a DataContext a lista kijelölt eleme, a mezők kétirányúan kötve -->
        <Border Grid.Column="1" Margin="5" Padding="10" BorderBrush="Gray" BorderThickness="1" Background="Beige"
                DataContext="{Binding SelectedItem, ElementName=KonyvLista}">
            <StackPanel>
                <TextBlock Text="Kijelölt könyv" FontWeight="Bold" Margin="0,0,0,10"/>
                <Label Content="Cím:" Padding="0"/>
                <TextBox Text="{Binding Cim, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="Szerző:" Padding="0"/>
                <TextBox Text="{Binding Szerzo, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="Kiadás éve:" Padding="0"/>
                <TextBox Text="{Binding Ev, UpdateSourceTrigger=PropertyChanged}"/>
                <CheckBox Content="kölcsönözve" IsChecked="{Binding Kolcsonozve}"/>
                <TextBlock Margin="0,15,0,0" TextWrapping="Wrap" Foreground="DimGray" FontSize="13"
                           Text="Gépelj a mezőkbe: a lista azonnal frissül, egyetlen eseménykezelő nélkül."/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
