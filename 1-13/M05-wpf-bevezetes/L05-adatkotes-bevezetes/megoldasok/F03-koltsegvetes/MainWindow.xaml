<Window x:Class="Koltsegvetes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Költségvetés-napló" Height="640" Width="980" MinHeight="540" MinWidth="860"
        FontSize="14" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="BevetelSzin" Color="ForestGreen"/>
        <SolidColorBrush x:Key="KiadasSzin" Color="Firebrick"/>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,4,0,2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,6,6,0"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="8">
        <!-- Összesítő az ablak alján: az ablak tulajdonságaihoz kötve -->
        <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="8" Background="#F2F2F2" BorderBrush="Gray" BorderThickness="1">
            <TextBlock FontSize="16">
                <Run Text="Bevétel: "/><Run Text="{Binding Bevetel, Mode=OneWay, StringFormat={}{0:N0} Ft}" Foreground="{StaticResource BevetelSzin}"/>
                <Run Text="  ·  Kiadás: "/><Run Text="{Binding Kiadasok, Mode=OneWay, StringFormat={}{0:N0} Ft}" Foreground="{StaticResource KiadasSzin}"/>
                <Run Text="  ·  Egyenleg: "/>
                <Run Text="{Binding Egyenleg, Mode=OneWay, StringFormat={}{0:N0} Ft}" FontWeight="Bold">
                    <Run.Style>
                        <Style TargetType="Run">
                            <Setter Property="Foreground" Value="Black"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Negativ}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource KiadasSzin}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Run.Style>
                </Run>
            </TextBlock>
        </Border>

        <!-- Jobb oldal: új tétel és a kijelölt szerkesztése -->
        <StackPanel DockPanel.Dock="Right" Width="300" Margin="8,0,0,0">
            <GroupBox Header="Új tétel">
                <StackPanel>
                    <Label Content="Megnevezés:"/>
                    <TextBox Name="UjMegnevezes"/>
                    <Label Content="Kategória:"/>
                    <ComboBox Name="UjKategoria" IsEditable="True"/>
                    <Label Content="Dátum:"/>
                    <DatePicker Name="UjDatum"/>
                    <Label Content="Összeg (Ft):"/>
                    <TextBox Name="UjOsszeg"/>
                    <CheckBox Name="UjKiadas" Content="kiadás" IsChecked="True" Margin="0,6,0,0"/>
                    <Button Content="Hozzáadás" HorizontalAlignment="Left" Click="HozzaadasGomb_Click"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Kijelölt tétel" DataContext="{Binding SelectedItem, ElementName=TetelLista}">
                <StackPanel>
                    <Label Content="Megnevezés:"/>
                    <TextBox Text="{Binding Megnevezes, UpdateSourceTrigger=PropertyChanged}"/>
                    <Label Content="Összeg (Ft, kiadás negatív):"/>
                    <TextBox Text="{Binding Osszeg, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Törlés" HorizontalAlignment="Left" Click="TorlesGomb_Click"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <!-- Bal oldal: szűrők és lista -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <Label Content="Kategória:" VerticalAlignment="Center"/>
                <ComboBox Name="SzuroKategoria" Width="150" Margin="6,0"/>
                <Label Content="Keresés:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBox Name="SzuroSzoveg" Width="160" Margin="6,0" VerticalContentAlignment="Center"/>
            </StackPanel>

            <ListBox Name="TetelLista" ItemsSource="{Binding Tetelek}" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Osszeg, StringFormat={}{0:N0} Ft}"
                                       FontWeight="Bold" Width="110" TextAlignment="Right">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource BevetelSzin}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kiadas}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource KiadasSzin}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Datum, StringFormat={}{0:yyyy.MM.dd.}}"
                                       Width="95" Foreground="DimGray"/>
                            <TextBlock>
                                <Run Text="{Binding Megnevezes, Mode=OneWay}"/>
                                <Run Text="{Binding Kategoria, Mode=OneWay, StringFormat=({0})}" Foreground="Gray"/>
                            </TextBlock>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DockPanel>
</Window>
