<Window x:Class="NemzetiParkokCsvWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Magyarország nemzeti parkjai" Height="420" Width="720" MinHeight="300" MinWidth="500">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <Label Content="Keresés:" />
            <TextBox x:Name="txtSzuro" Width="180" VerticalContentAlignment="Center" TextChanged="Szuro_Valtozott" />
            <Label Content="Alapítás:" Margin="12,0,0,0" />
            <ComboBox x:Name="cbEvtized" Width="120" SelectionChanged="Szuro_Valtozott" />
        </WrapPanel>

        <DataGrid Grid.Row="1" x:Name="dgParkok" ItemsSource="{Binding Lista}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Név" Binding="{Binding Nev}" Width="*" />
                <DataGridTextColumn Header="Székhely" Binding="{Binding Szekhely}" Width="140" />
                <DataGridTextColumn Header="Alapítás éve" Binding="{Binding AlapitasEve}" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <Button Content="Megjelenítettek mentése" Width="170" Click="Mentes_Click" />
            <TextBlock Text="{Binding Lista.Count, StringFormat=Megjelenítve: {0} park}" VerticalAlignment="Center"
                       HorizontalAlignment="Right" />
        </DockPanel>
    </Grid>
</Window>
