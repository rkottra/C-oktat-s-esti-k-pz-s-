<Window x:Class="SablonWpfDataGrid.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SABLON – ablakcím" Height="450" Width="800" MinHeight="300" MinWidth="500">
    <!-- SABLON: háromsoros rács – szűrősáv / táblázat / gombsor. Minden * méretű, így reszponzív. -->
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <Label Content="Keresés:" />
            <TextBox x:Name="txtSzuro" Width="200" VerticalContentAlignment="Center" TextChanged="Szuro_TextChanged" />
        </WrapPanel>

        <DataGrid Grid.Row="1" x:Name="dgLista" ItemsSource="{Binding Lista}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Azonosító" Binding="{Binding Id}" />
                <DataGridTextColumn Header="Név" Binding="{Binding Nev}" Width="*" />
                <DataGridTextColumn Header="Érték" Binding="{Binding Ertek, StringFormat=F2}" />
                <DataGridTextColumn Header="Dátum" Binding="{Binding Datum, StringFormat=yyyy.MM.dd}" />
                <!-- Kapcsolt adat: Binding="{Binding Szulo.Nev}" (EF-ben Include kell hozzá) -->
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <Button Content="Új…" Width="100" Click="Uj_Click" />
            <Button Content="Kijelölt törlése" Width="120" Margin="8,0,0,0" Click="Torles_Click" />
            <TextBlock Text="{Binding Lista.Count, StringFormat=Megjelenítve: {0}}" VerticalAlignment="Center"
                       HorizontalAlignment="Right" />
        </DockPanel>
    </Grid>
</Window>
