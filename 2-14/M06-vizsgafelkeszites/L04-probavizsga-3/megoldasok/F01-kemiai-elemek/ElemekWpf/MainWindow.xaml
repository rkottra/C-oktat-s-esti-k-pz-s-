<Window x:Class="ElemekWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Periódusos rendszer – kémiai elemek" Height="560" Width="940" MinHeight="360" MinWidth="680">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <Label Content="Kategória:" />
            <ComboBox x:Name="cbKategoria" Width="170" DisplayMemberPath="Nev" SelectionChanged="Szuro_Valtozott" />
            <Label Content="Halmazállapot:" Margin="12,0,0,0" />
            <ComboBox x:Name="cbHalmaz" Width="120" SelectionChanged="Szuro_Valtozott" />
        </WrapPanel>

        <DataGrid Grid.Row="1" x:Name="dgElemek" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Rendszám" Binding="{Binding Rendszam}" />
                <DataGridTextColumn Header="Vegyjel" Binding="{Binding Vegyjel}" />
                <DataGridTextColumn Header="Név" Binding="{Binding Nev}" Width="*" />
                <DataGridTextColumn Header="Kategória" Binding="{Binding Kategoria.Nev}" Width="*" />
                <DataGridTextColumn Header="Periódus" Binding="{Binding Periodus}" />
                <DataGridTextColumn Header="Csoport" Binding="{Binding Csoport}" />
                <DataGridTextColumn Header="Atomtömeg" Binding="{Binding Atomtomeg, StringFormat=F3}" />
                <!-- null érték esetén üres cella marad -->
                <DataGridTextColumn Header="Elektronegativitás" Binding="{Binding Elektronegativitas, StringFormat=F2}" />
                <DataGridTextColumn Header="Halmazállapot" Binding="{Binding Halmazallapot}" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <Button Content="Új elem…" Width="120" Click="UjElem_Click" />
            <Button Content="Kijelölt törlése" Width="120" Margin="8,0,0,0" Click="Torles_Click" />
            <TextBlock x:Name="txtAllapot" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </DockPanel>
    </Grid>
</Window>
