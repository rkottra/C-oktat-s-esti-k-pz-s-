<Window x:Class="ElemekWpf.UjElemAblak"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Új elem" Height="420" Width="380" MinHeight="400" MinWidth="320"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="Rendszám:" />
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtRendszam" Margin="0,3" />
        <Label Grid.Row="1" Content="Vegyjel:" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtVegyjel" Margin="0,3" />
        <Label Grid.Row="2" Content="Név:" />
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtNev" Margin="0,3" />
        <Label Grid.Row="3" Content="Kategória:" />
        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="cbKategoria" Margin="0,3" DisplayMemberPath="Nev" />
        <Label Grid.Row="4" Content="Periódus (1–7):" />
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtPeriodus" Margin="0,3" />
        <Label Grid.Row="5" Content="Csoport (1–18):" />
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="txtCsoport" Margin="0,3" />
        <Label Grid.Row="6" Content="Atomtömeg:" />
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="txtAtomtomeg" Margin="0,3" />
        <Label Grid.Row="7" Content="Elektronegativitás:" />
        <TextBox Grid.Row="7" Grid.Column="1" x:Name="txtElektroneg" Margin="0,3"
                 ToolTip="Nem kötelező; ha megadod, 0 és 4 közötti szám" />
        <Label Grid.Row="8" Content="Halmazállapot:" />
        <ComboBox Grid.Row="8" Grid.Column="1" x:Name="cbHalmaz" Margin="0,3" />

        <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center"
                    VerticalAlignment="Bottom">
            <Button Content="Mentés" Width="100" Margin="4" IsDefault="True" Click="Mentes_Click" />
            <Button Content="Mégse" Width="100" Margin="4" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
