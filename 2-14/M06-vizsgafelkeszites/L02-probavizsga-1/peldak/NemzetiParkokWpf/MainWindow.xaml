<Window x:Class="NemzetiParkokWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nemzeti parkok" Height="420" Width="760" MinHeight="300" MinWidth="560">
    <!-- Reszponzív elrendezés: csillagos (*) oszlopok, a táblázat kitölti a helyet -->
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,8,0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Kijelölt törlése" Width="130" Click="Torles_Click" />
                <TextBlock x:Name="txtDarab" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <!-- IsReadOnly: a táblázatban nem szerkesztünk, csak megjelenítünk -->
            <DataGrid x:Name="dgParkok" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Név" Binding="{Binding Nev}" Width="*" />
                    <DataGridTextColumn Header="Székhely" Binding="{Binding Szekhely}" Width="110" />
                    <DataGridTextColumn Header="Alapítás" Binding="{Binding AlapitasEve}" Width="70" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <GroupBox Grid.Column="1" Header="Új nemzeti park">
            <StackPanel Margin="6">
                <Label Content="Név:" />
                <TextBox x:Name="txtNev" />
                <Label Content="Székhely:" />
                <TextBox x:Name="txtSzekhely" />
                <Label Content="Alapítás éve:" />
                <TextBox x:Name="txtEv" />
                <Button Content="Mentés" Margin="0,12,0,0" Click="Mentes_Click" />
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
