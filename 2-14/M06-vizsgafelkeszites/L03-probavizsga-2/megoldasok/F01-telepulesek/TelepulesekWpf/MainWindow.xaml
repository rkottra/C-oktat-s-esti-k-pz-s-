<Window x:Class="TelepulesekWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Magyarország városai" Height="520" Width="820" MinHeight="300" MinWidth="560">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid x:Name="dgTelepulesek" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Név" Binding="{Binding Nev}" Width="*" />
                <!-- Navigációs tulajdonságon keresztül a kapcsolt tábla mezője -->
                <DataGridTextColumn Header="Megye" Binding="{Binding Megye.Nev}" Width="*" />
                <DataGridTextColumn Header="Járás" Binding="{Binding Jaras}" Width="*" />
                <DataGridTextColumn Header="Népesség (fő)" Binding="{Binding Nepesseg}" />
                <DataGridTextColumn Header="Terület (km²)" Binding="{Binding Terulet, StringFormat=F2}" />
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="1" Content="Új felvétel" Width="160" Margin="0,8,0,0" HorizontalAlignment="Center"
                Click="UjFelvetel_Click" />
    </Grid>
</Window>
