<Window x:Class="TelepulesekSzures.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Magyarország városai – megyeszűrő" Height="540" Width="840" MinHeight="320" MinWidth="600">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <Label Content="Megye:" />
            <ComboBox x:Name="cbSzuro" Width="220" DisplayMemberPath="Nev" SelectionChanged="Szuro_SelectionChanged" />
            <TextBlock x:Name="txtOsszesito" Margin="12,0,0,0" VerticalAlignment="Center" />
        </WrapPanel>

        <DataGrid Grid.Row="1" x:Name="dgTelepulesek" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Név" Binding="{Binding Nev}" Width="*" />
                <DataGridTextColumn Header="Megye" Binding="{Binding Megye.Nev}" Width="*" />
                <DataGridTextColumn Header="Járás" Binding="{Binding Jaras}" Width="*" />
                <DataGridTextColumn Header="Népesség (fő)" Binding="{Binding Nepesseg}" />
                <DataGridTextColumn Header="Terület (km²)" Binding="{Binding Terulet, StringFormat=F2}" />
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" Content="Új felvétel" Width="160" Margin="0,8,0,0" HorizontalAlignment="Center"
                Click="UjFelvetel_Click" />
    </Grid>
</Window>
