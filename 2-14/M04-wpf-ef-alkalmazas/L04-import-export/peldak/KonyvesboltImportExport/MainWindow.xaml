<Window x:Class="KonyvesboltImportExport.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Könyvesbolt – import és export" Height="520" Width="950">
    <DockPanel Margin="10">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button Content="CSV importálása…" Click="CsvImport_Click" Padding="8,4" Margin="0,0,6,0" />
            <Button Content="Exportálás JSON-ba…" Click="JsonExport_Click" Padding="8,4" Margin="0,0,6,0" />
            <Button Content="Exportálás XML-be…" Click="XmlExport_Click" Padding="8,4" Margin="0,0,16,0" />
            <Label Content="Kiadó:" VerticalAlignment="Center" />
            <ComboBox x:Name="cmbSzuroKiado" Width="160" DisplayMemberPath="Nev"
                      SelectionChanged="CmbSzuroKiado_SelectionChanged"
                      ToolTip="Az export a táblázatban látható (szűrt) könyveket menti" />
        </WrapPanel>

        <TextBlock x:Name="txtAllapot" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" />

        <DataGrid x:Name="dgKonyvek" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Cím" Binding="{Binding Cim}" Width="*" />
                <DataGridTextColumn Header="Szerző" Binding="{Binding Szerzo}" Width="170" />
                <DataGridTextColumn Header="Év" Binding="{Binding KiadasEve}" Width="60" />
                <DataGridTextColumn Header="Ár (Ft)" Binding="{Binding Ar, StringFormat={}{0:N0}}" Width="80" />
                <DataGridTextColumn Header="Készlet" Binding="{Binding Keszlet}" Width="70" />
                <DataGridTextColumn Header="Kiadó" Binding="{Binding Kiado.Nev}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
