<Window x:Class="RaktarSzuro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raktár – szűrés kategóriára" Height="480" Width="960">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Label Content="Kategória:" VerticalAlignment="Center" />
            <ComboBox x:Name="cmbSzuro" Width="200" DisplayMemberPath="Nev"
                      SelectionChanged="CmbSzuro_SelectionChanged" />
        </StackPanel>

        <TextBlock x:Name="txtOsszesites" DockPanel.Dock="Bottom" Margin="0,8,0,0" FontWeight="Bold" />

        <Border DockPanel.Dock="Right" Width="250" Margin="10,0,0,0" Padding="10"
                BorderBrush="LightGray" BorderThickness="1"
                DataContext="{Binding ElementName=dgTermekek, Path=SelectedItem}">
            <StackPanel>
                <TextBlock Text="Részletek" FontWeight="Bold" Margin="0,0,0,8" />
                <Label Content="Cikkszám" Padding="0" />
                <TextBox Text="{Binding Cikkszam, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,6" />
                <Label Content="Név" Padding="0" />
                <TextBox Text="{Binding Nev, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,6" />
                <Label Content="Kategória" Padding="0" />
                <ComboBox x:Name="cmbKategoria" DisplayMemberPath="Nev" SelectedValuePath="Id"
                          SelectedValue="{Binding KategoriaId, Mode=OneWay}" IsEnabled="False" Margin="0,0,0,6" />
                <Label Content="Készlet" Padding="0" />
                <TextBox Text="{Binding Darab, Mode=OneWay}" IsReadOnly="True" />
            </StackPanel>
        </Border>

        <DataGrid x:Name="dgTermekek" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <!-- A Darab = 0 sorok halványpiros hátteret kapnak -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Darab}" Value="0">
                            <Setter Property="Background" Value="MistyRose" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Cikkszám" Binding="{Binding Cikkszam}" Width="80" />
                <DataGridTextColumn Header="Név" Binding="{Binding Nev}" Width="*" />
                <DataGridTextColumn Header="Kategória" Binding="{Binding Kategoria.Nev}" Width="120" />
                <DataGridTextColumn Header="Ár (Ft)" Binding="{Binding Ar, StringFormat={}{0:N0}}" Width="80" />
                <DataGridTextColumn Header="Darab" Binding="{Binding Darab}" Width="60" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
