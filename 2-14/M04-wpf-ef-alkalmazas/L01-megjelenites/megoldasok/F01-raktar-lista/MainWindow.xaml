<Window x:Class="RaktarLista.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raktár – terméklista" Height="450" Width="800">
    <DockPanel Margin="10">
        <TextBlock x:Name="txtOsszesites" DockPanel.Dock="Bottom" Margin="0,8,0,0" FontWeight="Bold" />

        <DataGrid x:Name="dgTermekek" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Cikkszám" Binding="{Binding Cikkszam}" Width="80" />
                <DataGridTextColumn Header="Név" Binding="{Binding Nev}" Width="*" />
                <DataGridTextColumn Header="Kategória" Binding="{Binding Kategoria.Nev}" Width="130" />
                <DataGridTextColumn Header="Ár (Ft)" Binding="{Binding Ar, StringFormat={}{0:N0}}" Width="80" />
                <DataGridTextColumn Header="Darab" Binding="{Binding Darab}" Width="60" />
                <DataGridTextColumn Header="Érték (Ft)" Binding="{Binding Ertek, StringFormat={}{0:N0}}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
