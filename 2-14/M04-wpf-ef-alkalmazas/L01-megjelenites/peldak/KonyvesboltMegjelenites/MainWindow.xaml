<Window x:Class="KonyvesboltMegjelenites.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Könyvesbolt – készlet" Height="480" Width="980">
    <DockPanel Margin="10">

        <!-- Felső sáv: szűrés kiadó szerint (ComboBox a kapcsolt táblából) -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Label Content="Kiadó:" VerticalAlignment="Center" />
            <ComboBox x:Name="cmbSzuroKiado" Width="200"
                      DisplayMemberPath="Nev"
                      SelectionChanged="CmbSzuroKiado_SelectionChanged" />
        </StackPanel>

        <!-- Alsó sáv: összesítés -->
        <TextBlock x:Name="txtOsszesites" DockPanel.Dock="Bottom" Margin="0,8,0,0" />

        <!-- Jobb oldal: a kijelölt könyv adatai. A DataContext a DataGrid kijelölt eleme. -->
        <Border DockPanel.Dock="Right" Width="260" Margin="10,0,0,0" Padding="10"
                BorderBrush="LightGray" BorderThickness="1"
                DataContext="{Binding ElementName=dgKonyvek, Path=SelectedItem}">
            <StackPanel>
                <TextBlock Text="Kijelölt könyv" FontWeight="Bold" Margin="0,0,0,8" />
                <Label Content="Cím" Padding="0" />
                <TextBox Text="{Binding Cim, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,6" />
                <Label Content="Szerző" Padding="0" />
                <TextBox Text="{Binding Szerzo, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,6" />
                <Label Content="Kiadó" Padding="0" />
                <!-- ComboBox kapcsolt táblával: a listában a kiadók vannak,
                     a kiválasztott elemet a könyv KiadoId idegen kulcsa határozza meg. -->
                <ComboBox x:Name="cmbKiado"
                          DisplayMemberPath="Nev"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding KiadoId, Mode=OneWay}"
                          IsEnabled="False" />
            </StackPanel>
        </Border>

        <!-- A táblázat: kézzel megadott oszlopok, csak olvasható -->
        <DataGrid x:Name="dgKonyvek"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Cím" Binding="{Binding Cim}" Width="*" />
                <DataGridTextColumn Header="Szerző" Binding="{Binding Szerzo}" Width="150" />
                <DataGridTextColumn Header="Év" Binding="{Binding KiadasEve}" Width="60" />
                <DataGridTextColumn Header="Ár (Ft)" Binding="{Binding Ar, StringFormat={}{0:N0}}" Width="80" />
                <DataGridTextColumn Header="Készlet" Binding="{Binding Keszlet}" Width="70" />
                <!-- A navigációs tulajdonságon át a kapcsolt tábla mezője is megjeleníthető -->
                <DataGridTextColumn Header="Kiadó" Binding="{Binding Kiado.Nev}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
