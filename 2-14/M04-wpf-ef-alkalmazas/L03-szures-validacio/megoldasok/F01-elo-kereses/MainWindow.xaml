<Window x:Class="RaktarKereses.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raktár – keresés" Height="500" Width="950">
    <DockPanel Margin="10">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Label Content="Keresés:" VerticalAlignment="Center" />
            <TextBox x:Name="txtKereses" Width="180" VerticalContentAlignment="Center"
                     TextChanged="Szuro_Valtozott" ToolTip="Név vagy cikkszám részlete" />
            <Label Content="Kategória:" Margin="10,0,0,0" VerticalAlignment="Center" />
            <ComboBox x:Name="cmbKategoria" Width="140" DisplayMemberPath="Nev"
                      SelectionChanged="Szuro_Valtozott" />
            <Label Content="Rendezés:" Margin="10,0,0,0" VerticalAlignment="Center" />
            <ComboBox x:Name="cmbRendezes" Width="130" SelectionChanged="Szuro_Valtozott">
                <ComboBoxItem Content="név szerint" IsSelected="True" />
                <ComboBoxItem Content="ár szerint ↑" />
                <ComboBoxItem Content="ár szerint ↓" />
                <ComboBoxItem Content="érték szerint ↓" />
            </ComboBox>
            <CheckBox x:Name="chkHiany" Content="csak hiánycikkek" Margin="10,0,0,0"
                      VerticalAlignment="Center" Click="Szuro_Valtozott" />
        </WrapPanel>

        <TextBlock x:Name="txtAllapot" DockPanel.Dock="Bottom" Margin="0,8,0,0" FontWeight="Bold" />

        <DataGrid x:Name="dgTermekek" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Cikkszám" Binding="{Binding Cikkszam}" Width="80" />
                <DataGridTextColumn Header="Név" Binding="{Binding Nev}" Width="*" />
                <DataGridTextColumn Header="Kategória" Binding="{Binding Kategoria.Nev}" Width="120" />
                <DataGridTextColumn Header="Ár (Ft)" Binding="{Binding Ar, StringFormat={}{0:N0}}" Width="80" />
                <DataGridTextColumn Header="Darab" Binding="{Binding Darab}" Width="60" />
                <DataGridTextColumn Header="Érték (Ft)" Binding="{Binding Ertek, StringFormat={}{0:N0}}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
