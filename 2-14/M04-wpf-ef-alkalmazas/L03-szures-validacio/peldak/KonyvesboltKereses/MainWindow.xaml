<Window x:Class="KonyvesboltKereses.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Könyvesbolt – keresés és ellenőrzött mentés" Height="560" Width="1050">
    <DockPanel Margin="10">

        <!-- Keresősáv: minden változás azonnal szűr (élő keresés) -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Label Content="Keresés (cím vagy szerző):" VerticalAlignment="Center" />
            <TextBox x:Name="txtKereses" Width="200" VerticalContentAlignment="Center"
                     TextChanged="Szuromezo_Valtozott" />
            <Label Content="Kiadó:" Margin="12,0,0,0" VerticalAlignment="Center" />
            <ComboBox x:Name="cmbSzuroKiado" Width="150" DisplayMemberPath="Nev"
                      SelectionChanged="Szuromezo_Valtozott" />
            <CheckBox x:Name="chkCsakKeszleten" Content="csak készleten lévők" Margin="12,0,0,0"
                      VerticalAlignment="Center" Click="Szuromezo_Valtozott" />
        </StackPanel>

        <TextBlock x:Name="txtAllapot" DockPanel.Dock="Bottom" Margin="0,8,0,0" />

        <Border x:Name="pnlUrlap" DockPanel.Dock="Right" Width="280" Margin="10,0,0,0" Padding="10"
                BorderBrush="LightGray" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="txtUrlapCim" Text="Új könyv" FontWeight="Bold" Margin="0,0,0,8" />
                <Label Content="Cím" Padding="0" />
                <TextBox x:Name="txtCim" Margin="0,0,0,6" />
                <Label Content="Szerző" Padding="0" />
                <TextBox x:Name="txtSzerzo" Margin="0,0,0,6" />
                <Label Content="Kiadás éve" Padding="0" />
                <TextBox x:Name="txtEv" Margin="0,0,0,6" />
                <Label Content="Ár (Ft)" Padding="0" />
                <TextBox x:Name="txtAr" Margin="0,0,0,6" />
                <Label Content="Készlet (db)" Padding="0" />
                <TextBox x:Name="txtKeszlet" Margin="0,0,0,6" />
                <Label Content="Kiadó" Padding="0" />
                <ComboBox x:Name="cmbKiado" DisplayMemberPath="Nev" SelectedValuePath="Id" Margin="0,0,0,12" />
                <UniformGrid Columns="3">
                    <Button Content="Új" Click="Uj_Click" Margin="0,0,4,0" Padding="4" />
                    <Button Content="Mentés" Click="Mentes_Click" Margin="2,0" Padding="4" FontWeight="Bold" />
                    <Button x:Name="btnTorles" Content="Törlés" Click="Torles_Click" Margin="4,0,0,0" Padding="4" />
                </UniformGrid>
                <!-- Itt jelennek meg az ellenőrzés hibaüzenetei -->
                <TextBlock x:Name="txtHibak" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <DataGrid x:Name="dgKonyvek" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  SelectionChanged="DgKonyvek_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Cím" Binding="{Binding Cim}" Width="*" />
                <DataGridTextColumn Header="Szerző" Binding="{Binding Szerzo}" Width="150" />
                <DataGridTextColumn Header="Év" Binding="{Binding KiadasEve}" Width="60" />
                <DataGridTextColumn Header="Ár (Ft)" Binding="{Binding Ar, StringFormat={}{0:N0}}" Width="80" />
                <DataGridTextColumn Header="Készlet" Binding="{Binding Keszlet}" Width="70" />
                <DataGridTextColumn Header="Kiadó" Binding="{Binding Kiado.Nev}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
