<Window x:Class="KonyvtarDataGrid.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Könyvtár – DataGrid" Height="450" Width="820">
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- SelectedItem TwoWay módon az ablak Kivalasztott tulajdonságához kötve -->
        <DataGrid Name="KonyvTabla" ItemsSource="{Binding Konyvek}"
                  SelectedItem="{Binding Kivalasztott, Mode=TwoWay}"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  SelectionMode="Single" Margin="0,0,5,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Cím" Binding="{Binding Cim}" Width="2*"/>
                <DataGridTextColumn Header="Szerző" Binding="{Binding Szerzo}" Width="*"/>
                <DataGridTextColumn Header="Év" Binding="{Binding KiadasEve}" Width="60"/>
                <DataGridCheckBoxColumn Header="Kölcsönözve" Binding="{Binding Kolcsonozve, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                <DataGridTextColumn Header="Állapot" Binding="{Binding Allapot}" Width="90" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Részletek: a DataContext a kiválasztott könyv -->
        <GroupBox Grid.Column="1" Header="Részletek" Padding="5" DataContext="{Binding Kivalasztott}">
            <StackPanel>
                <TextBlock Text="{Binding Cim}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Szerzo}"/>
                <TextBlock Text="{Binding KiadasEve, StringFormat='Kiadás éve: {0}'}"/>
                <TextBlock Text="{Binding Allapot, StringFormat='Állapot: {0}'}" Margin="0,5"/>
                <Button Content="Kölcsönzés / visszahozás" Margin="0,10,0,0" Click="Kolcsonzes_Click"/>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,5,0,0">
            <Button Content="Új könyv" Width="100" Margin="0,0,5,0" Click="Uj_Click"/>
            <Button Content="Törlés" Width="100" Margin="0,0,15,0" Click="Torles_Click"/>
            <!-- Az ablak saját, értesítést küldő tulajdonságához kötve -->
            <TextBlock VerticalAlignment="Center"
                       Text="{Binding KolcsonzottDb, StringFormat='Kölcsönzött könyvek: {0} db'}"/>
        </StackPanel>
    </Grid>
</Window>
