<Window x:Class="DataContextSzemelyek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DataContext és ObservableCollection" Height="480" Width="720">
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ItemsSource: a lista elemei a DataContext (az ablak) Szemelyek tulajdonságából jönnek.
             Az ItemTemplate mondja meg, hogyan nézzen ki EGY elem. -->
        <ListBox Name="SzemelyLista" ItemsSource="{Binding Szemelyek}" Margin="0,0,5,5" Background="Bisque">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- A sablonon belül a DataContext már az adott Szemely objektum -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Nev}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Varos, StringFormat=' – {0}'}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- A jobb oldali panel DataContextje a listában kiválasztott személy.
             Így a belső Binding-oknak elég a tulajdonság neve. -->
        <StackPanel Grid.Column="1" Margin="5,0,0,5"
                    DataContext="{Binding ElementName=SzemelyLista, Path=SelectedItem}">
            <Label Content="Név:"/>
            <TextBox Text="{Binding Nev, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Content="Életkor:"/>
            <TextBox Text="{Binding Kor}"/>
            <Label Content="Város:"/>
            <TextBox Text="{Binding Varos}"/>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Megmutat" Width="100" Margin="0,0,5,0" Click="Megmutat_Click"/>
                <Button Content="Születésnap" Width="100" Click="Szuletesnap_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Button Content="Új személy" Width="100" Margin="0,0,5,0" Click="Uj_Click"/>
                <Button Content="Törlés" Width="100" Click="Torles_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Ugyanaz a gyűjtemény egy DataGridben is: minden változás mindkét helyen látszik.
             AutoGenerateColumns="False": mi adjuk meg az oszlopokat. -->
        <DataGrid Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding Szemelyek}"
                  SelectedItem="{Binding ElementName=SzemelyLista, Path=SelectedItem, Mode=TwoWay}"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Név" Binding="{Binding Nev}" Width="*"/>
                <DataGridTextColumn Header="Életkor" Binding="{Binding Kor}" Width="80"/>
                <DataGridTextColumn Header="Város" Binding="{Binding Varos}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
