<Window x:Class="Bevasarlolista.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bevásárlólista" Height="420" Width="600" MinWidth="450" MinHeight="300">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Új tétel felvétele: a gomb IsDefault, így Enterre is lefut -->
        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,5">
            <Label DockPanel.Dock="Left" Content="Új tétel:"/>
            <Button DockPanel.Dock="Right" Name="HozzaadGomb" Content="Hozzáadás" Width="100"
                    IsDefault="True" Click="HozzaadGomb_Click"/>
            <TextBox Name="TetelMezo" Margin="5,0" VerticalContentAlignment="Center"/>
        </DockPanel>

        <Label Grid.Row="1" Grid.Column="0" Content="Megveendő (dupla kattintás: megvettem)"/>
        <Label Grid.Row="1" Grid.Column="1" Content="Már a kosárban"/>

        <ListBox Grid.Row="2" Grid.Column="0" Name="MegveendoLista" Margin="0,0,3,0"
                 MouseDoubleClick="MegveendoLista_MouseDoubleClick"/>
        <ListBox Grid.Row="2" Grid.Column="1" Name="KosarLista" Margin="3,0,0,0" Foreground="Gray"/>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,5,0,0">
            <Button Name="TorlesGomb" Content="Kijelölt törlése" Width="120" Margin="0,0,5,0" Click="TorlesGomb_Click"/>
            <Button Name="UritesGomb" Content="Lista ürítése" Width="120" Click="UritesGomb_Click"/>
            <Label Name="AllapotCimke" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
