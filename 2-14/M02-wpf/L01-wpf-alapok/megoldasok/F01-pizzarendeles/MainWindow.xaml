<Window x:Class="Pizzarendeles.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pizzarendelés" Height="430" Width="700" MinWidth="550" MinHeight="400">
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Bal oldal: az űrlap -->
        <StackPanel Grid.Column="0" Margin="5">
            <Label Content="Pizza:"/>
            <!-- A Tag tulajdonságban tároljuk az árat, így a kódból kiolvasható -->
            <ComboBox Name="PizzaValaszto" SelectedIndex="0" Margin="5,0">
                <ComboBoxItem Content="Margherita (2490 Ft)" Tag="2490"/>
                <ComboBoxItem Content="Sonkás (2890 Ft)" Tag="2890"/>
                <ComboBoxItem Content="Hawaii (3090 Ft)" Tag="3090"/>
                <ComboBoxItem Content="Négysajtos (3290 Ft)" Tag="3290"/>
            </ComboBox>

            <GroupBox Header="Méret" Margin="5">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Name="KicsiRadio" Content="32 cm" Margin="5" IsChecked="True"/>
                    <RadioButton Name="NagyRadio" Content="45 cm (+1200 Ft)" Margin="5"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Extra feltétek" Margin="5">
                <StackPanel>
                    <CheckBox Name="SajtCheck" Content="extra sajt (+400 Ft)" Margin="3"/>
                    <CheckBox Name="KukoricaCheck" Content="kukorica (+300 Ft)" Margin="3"/>
                    <CheckBox Name="JalapenoCheck" Content="jalapeño (+300 Ft)" Margin="3"/>
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal" Margin="5">
                <Label Content="Darab:"/>
                <TextBox Name="DarabMezo" Text="1" Width="50" VerticalContentAlignment="Center"/>
                <CheckBox Name="KiszallitasCheck" Content="Kiszállítás (+590 Ft)" Margin="15,0,0,0"
                          VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="5">
                <Button Name="ArGomb" Content="Ár számítása" Width="110" Margin="0,0,5,0" Click="ArGomb_Click"/>
                <Button Name="RendelesGomb" Content="Rendelés" Width="110" Click="RendelesGomb_Click"/>
            </StackPanel>
            <Label Name="OsszegCimke" Content="Fizetendő: –" FontSize="16" FontWeight="Bold"/>
        </StackPanel>

        <!-- Jobb oldal: a leadott rendelések -->
        <DockPanel Grid.Column="1" Margin="5">
            <Label DockPanel.Dock="Top" Content="Leadott rendelések:"/>
            <Button DockPanel.Dock="Bottom" Name="TorlesGomb" Content="Kijelölt rendelés törlése"
                    Margin="0,5,0,0" Click="TorlesGomb_Click"/>
            <ListBox Name="RendelesLista"/>
        </DockPanel>
    </Grid>
</Window>
