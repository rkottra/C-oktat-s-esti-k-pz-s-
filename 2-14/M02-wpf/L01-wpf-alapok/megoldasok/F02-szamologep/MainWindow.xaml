<Window x:Class="Szamologep.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Számológép" Height="520" Width="380" MinHeight="400" MinWidth="300" FontSize="26">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="1.3*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Kijelző: mind a 4 oszlopon átnyúlik, csak olvasható -->
        <TextBox Name="Kijelzo" Grid.ColumnSpan="4" Text="0" IsReadOnly="True" Margin="5"
                 HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                 FontWeight="Bold" Background="Bisque"/>

        <!-- Számgombok: mind ugyanazt az eseménykezelőt hívják, a számjegy a Tag-ben van -->
        <Button Grid.Row="1" Grid.Column="0" Content="7" Tag="7" Margin="4" Click="Szamjegy_Click"/>
        <Button Grid.Row="1" Grid.Column="1" Content="8" Tag="8" Margin="4" Click="Szamjegy_Click"/>
        <Button Grid.Row="1" Grid.Column="2" Content="9" Tag="9" Margin="4" Click="Szamjegy_Click"/>
        <Button Grid.Row="2" Grid.Column="0" Content="4" Tag="4" Margin="4" Click="Szamjegy_Click"/>
        <Button Grid.Row="2" Grid.Column="1" Content="5" Tag="5" Margin="4" Click="Szamjegy_Click"/>
        <Button Grid.Row="2" Grid.Column="2" Content="6" Tag="6" Margin="4" Click="Szamjegy_Click"/>
        <Button Grid.Row="3" Grid.Column="0" Content="1" Tag="1" Margin="4" Click="Szamjegy_Click"/>
        <Button Grid.Row="3" Grid.Column="1" Content="2" Tag="2" Margin="4" Click="Szamjegy_Click"/>
        <Button Grid.Row="3" Grid.Column="2" Content="3" Tag="3" Margin="4" Click="Szamjegy_Click"/>
        <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Content="0" Tag="0" Margin="4" Click="Szamjegy_Click"/>
        <Button Grid.Row="4" Grid.Column="2" Content="C" Margin="4" Background="MistyRose" Click="Torles_Click"/>

        <!-- Műveleti gombok: egy közös kezelő, a művelet jele a Content -->
        <Button Grid.Row="1" Grid.Column="3" Content="/" Margin="4" Click="Muvelet_Click"/>
        <Button Grid.Row="2" Grid.Column="3" Content="*" Margin="4" Click="Muvelet_Click"/>
        <Button Grid.Row="3" Grid.Column="3" Content="-" Margin="4" Click="Muvelet_Click"/>
        <Button Grid.Row="4" Grid.Column="3" Content="+" Margin="4" Click="Muvelet_Click"/>
        <Button Grid.Row="5" Grid.ColumnSpan="4" Content="=" Margin="4" Background="LightGreen" Click="Egyenlo_Click"/>
    </Grid>
</Window>
